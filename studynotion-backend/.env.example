# =============================================
# StudyNotion Spring Boot Backend - Environment Variables
# Copy this file to .env and fill in your values
# =============================================

# Server
PORT=8080

# PostgreSQL Database (from Render / local)
DATABASE_URL=jdbc:postgresql://localhost:5432/studynotion
DB_USERNAME=postgres
DB_PASSWORD=yourpassword

# JWT
JWT_SECRET=your-super-secret-key-minimum-32-chars-long-make-it-random

# Email (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password   # Use App Password, not actual password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Anthropic (Claude AI)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Frontend URL (for CORS)
FRONTEND_URL=https://your-app.vercel.app
