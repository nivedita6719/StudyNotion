# =====================================================
# StudyNotion Spring Boot backend — environment variables
# Copy to `.env` for local runs, or set these in Render's
# dashboard. `.env` is gitignored.
# =====================================================

PORT=8080

# ── Database ─────────────────────────────────────────
# Local: point at your Postgres. On Render these come from the
# managed database's "Info" tab (see render.yaml — they are wired
# automatically as DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=studynotion
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Optional: full JDBC URL overrides the DB_* parts above
# DATABASE_URL=jdbc:postgresql://localhost:5432/studynotion

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# ── Email (Gmail SMTP) ───────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# ── Cloudinary ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Razorpay ─────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ── Google Gemini (AI) ───────────────────────────────
GEMINI_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash

# ── CORS / frontend ──────────────────────────────────
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# ── Misc (optional) ──────────────────────────────────
JPA_DDL_AUTO=update
LOG_LEVEL_APP=INFO
