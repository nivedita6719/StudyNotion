# Local development against the Spring Boot backend on :8080
REACT_APP_BASE_URL=http://localhost:8080/api/v1

# When running the full stack via `docker compose`, nginx proxies /api,
# so use a relative path instead:
# REACT_APP_BASE_URL=/api/v1

# Optional: Razorpay publishable key. The backend also returns this in the
# capturePayment response, so setting it here is just a fallback.
# REACT_APP_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
